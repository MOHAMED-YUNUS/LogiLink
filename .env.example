# LogiLink WhatsApp Chatbot Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# AI Configuration
AI_PROVIDER=ollama
# Options: ollama, openai

# Ollama Configuration (Local AI - Preferred)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# OpenAI Configuration (Optional - for future use)
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL=gpt-3.5-turbo

# Database
DATABASE_PATH=./data/logilink.db

# WhatsApp Configuration
# Option 1: Meta Cloud API
WHATSAPP_API_PROVIDER=gupshup
GUPSHUP_API_KEY=sk_78675e2f5de94560ad6eab41ca406ac9
GUPSHUP_APP_ID=712d639d-083e-425a-a479-45ab341bc42e
GUPSHUP_PHONE_NUMBER=15551424784
GUPSHUP_MESSAGE_ID=2695505690912029
GUPSHUP_PHONE_NUMBER_ID=1568683689654954

# Option 2: Twilio (Alternative)
# WHATSAPP_API_PROVIDER=twilio
# TWILIO_ACCOUNT_SID=your-account-sid
# TWILIO_AUTH_TOKEN=your-auth-token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+1234567890

# Chatbot Configuration
CHATBOT_NAME=LogiLink
CHATBOT_TIMEZONE=Asia/Kolkata

# Logging
LOG_LEVEL=debug

# Testing
# Set to true to use WhatsApp Business Account test numbers
USE_WHATSAPP_TEST_MODE=true

