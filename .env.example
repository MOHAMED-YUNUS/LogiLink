# LogiLink WhatsApp Chatbot Configuration

# Server Configuration
PORT=5000
NODE_ENV=development

# AI Configuration
AI_PROVIDER=ollama
# Options: ollama, openai

# Ollama Configuration (Local AI - Preferred)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5

# OpenAI Configuration (Optional - for future use)
# OPENAI_API_KEY=your-api-key-here
# OPENAI_MODEL=gpt-3.5-turbo

# Database
DATABASE_PATH=./data/logilink.db

# WhatsApp Configuration
# Option 1: Meta Cloud API
WHATSAPP_API_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=198791396271485
WHATSAPP_BUSINESS_ACCOUNT_ID=1568683689654954
WHATSAPP_API_TOKEN=EAAY1hPnZA4y4BTPNLVnyaYNTqZCt9gZCOzgGcq1VXtdhiC0LZA9PlZA2KGCnhhJ3f24RfJwyU6prYGuLpz0RsgMOzZCNpgZBIq4wdbQWFsbwaxBPBkje8fWOHXXv1WXO2GPRVj0l92qJaOta5jDfSISvyEQ3JsaREUff9pRgM4lAfwryKsZAlhmit7LZA0lsMVaH4Gpan2TLYHqo46CX0N1QiIDHLifQ25ttXBuk4KoRb4IrZBi0KYSk1SRNh7w0L76y7TGKRYJXHQvEuSkLXUZBm12
